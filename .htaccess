# medeqon – Cache-Steuerung
# HTML/CSS/JS immer frisch (Browser muss beim Server nachfragen),
# Bilder/Fonts kurz zwischenspeichern (Performance), aber zeitnah aktualisieren.

<IfModule mod_headers.c>
  # Immer aktuell: Seiten, Stylesheet, Skripte
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  # Bilder & Schriften: 1 Stunde cachen
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico|woff|woff2|ttf)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 1 hour"
  ExpiresByType image/png "access plus 1 hour"
  ExpiresByType image/svg+xml "access plus 1 hour"
  ExpiresByType image/webp "access plus 1 hour"
</IfModule>
